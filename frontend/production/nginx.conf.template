worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    client_max_body_size 16k;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    log_format safe '$request_method $status $request_time';
    access_log /dev/stdout safe;

    map "$status:$uri" $cache_policy {
        default "no-store";
        ~^(200|304):/assets/ "public, max-age=31536000, immutable";
    }
    map $http_x_forwarded_proto $hsts {
        default "";
        https "max-age=31536000";
    }
    add_header Cache-Control $cache_policy always;
    add_header Strict-Transport-Security $hsts always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;

    server {
        listen 8080 default_server;
        server_name _;
        location = /healthz { default_type text/plain; return 200 'ok'; }
        # ALB health checks use a private IP Host and do not set forwarded headers.
        location = /api/v1/health/ready {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host __APP_HOST__;
        }
        location = /api/v1/health/live {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host __APP_HOST__;
        }
        location / { return 421; }
    }

    server {
        listen 8080;
        server_name __APP_HOST__;
        root /srv/frontend;
        location = /healthz { default_type text/plain; return 200 'ok'; }
        location ^~ /api/ {
            if ($http_x_forwarded_proto != "https") { return 400; }
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header X-Forwarded-Prefix "";
            proxy_set_header Forwarded "";
            proxy_hide_header Cache-Control;
            proxy_buffering off;
            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;
        }
        location ^~ /src/ { return 404; }
        location ^~ /node_modules/ { return 404; }
        location ~ /[.] { return 404; }
        location ~ [.] { try_files $uri =404; }
        location / { try_files $uri $uri/ /index.html; }
        error_page 413 = @request_too_large;
        location @request_too_large {
            default_type application/problem+json;
            return 413 '{"type":"about:blank","title":"Request too large","status":413,"detail":"The request body exceeds the 16 KiB limit."}';
        }
    }
}
